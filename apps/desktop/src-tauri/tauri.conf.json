{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenDiag",
  "version": "0.1.0",
  "identifier": "org.opendiag.app",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @opendiag/ui dev",
    "beforeBuildCommand": "pnpm --filter @opendiag/ui build"
  },
  "app": {
    "windows": [
      {
        "title": "OpenDiag",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "dmg"],
    "category": "Utility",
    "shortDescription": "Open-source vehicle diagnostics",
    "longDescription": "OpenDiag reads fault codes, live data and vehicle information through compatible OBD-II adapters. Free and open source.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "licenseFile": "../../../LICENSE"
  }
}
