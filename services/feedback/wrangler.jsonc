// OpenDiag community data: receives anonymous shared results from the app
// (opt-in) and publishes combined summaries. Cloudflare Workers + D1.
// Deploy: Workers & Pages → opendiag-data, root directory "services/feedback",
// deploy command "npx wrangler deploy" (see README.md in this folder).
{
  "name": "opendiag-data",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Pinned to the database the first deploy created (2026-10-21), so a
  // redeploy can never start a new, empty one.
  "d1_databases": [{ "binding": "DB", "database_name": "opendiag-data", "database_id": "8ce84578-7729-48ad-a816-ef191babcf6c" }],
  "observability": { "enabled": true },
  // Suggestions from the app become issues here. The token is a secret
  // (Settings → Variables and Secrets → GITHUB_TOKEN), never in this file.
  "vars": { "GITHUB_REPO": "MadsBjordal/OpenDiag" }
}
